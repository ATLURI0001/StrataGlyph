{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ATLURI0001/strataglyph",
  "title": "StrataGlyph",
  "description": "Architecture diagrams with official AWS, Azure, GCP and Kubernetes icons, to SVG, PNG and draw.io",
  "websiteUrl": "https://atluri0001.github.io/strataglyph/",
  "repository": {
    "url": "https://github.com/ATLURI0001/strataglyph",
    "source": "github"
  },
  "version": "0.13.0",
  "icons": [
    {
      "src": "https://atluri0001.github.io/strataglyph/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@atluri0001/strataglyph",
      "version": "0.13.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
